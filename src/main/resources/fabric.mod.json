{
  "schemaVersion": 1,
  "id": "too_many_entities",
  "version": "${version}",
  "name": "Too Many Entities",
  "description": "This mod allows you to hide extra entities in order to reduce lag, especially with mob farms. The mobs still exist in the world, they are just not visible.",
  "authors": [
    "Discusser"
  ],
  "contact": {
    "sources": "https://github.com/Discusser/TooManyEntities"
  },
  "license": "MIT",
  "icon": "assets/too_many_entities/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.discusser.toomanyentities.TooManyEntitiesClient"
    ],
    "modmenu": [
      "io.github.discusser.toomanyentities.TooManyEntitiesModMenuApi"
    ]
  },
  "mixins": [
    "too_many_entities.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "cloth-config": ">=${clothconfig_version}"
  },
  "recommends": {
    "entityculling": ">=${entityculling_version}",
    "modmenu": ">=${modmenu_version}"
  },
  "custom": {
    "modmenu": {
      "update_checker": true
    }
  }
}
